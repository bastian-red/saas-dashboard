# saas-dashboard environment.
#
#   cp .env.example .env
#   sed -i "s|^AUTH_SECRET=|AUTH_SECRET=$(openssl rand -base64 32)|" .env
#   sed -i "s|^BILLING_MOCK_SECRET=|BILLING_MOCK_SECRET=$(openssl rand -base64 32)|" .env
#
# Every name here is declared in turbo.json, and `node scripts/env-contract.mjs`
# fails the commit if this file, the source and turbo.json disagree. Turborepo 2
# runs in strict environment mode, so a name turbo.json forgets is stripped from
# the child process silently. Nothing loads this file on its own: `pnpm dev`
# runs scripts/dev.sh, which sources it.

# --- Core ---

# Leave unset for development: `next build` must not see "development".
NODE_ENV=

APP_VERSION=0.1.0

# --- Database (Postgres) ---

# TWO roles, on purpose. The services connect as saas_app, which owns no table
# and cannot bypass row-level security, so a query that forgets its tenant sees
# nothing rather than everything. The migrations create it without a password;
# `pnpm db:deploy` sets the one below. The API refuses to boot as anything else.
DATABASE_URL=postgresql://saas_app:saas_app_dev_password@localhost:5443/saas?schema=public

# The OWNER role: migrations, seeds and the drift check. Never a service.
DIRECT_DATABASE_URL=postgresql://saas_owner:saas_owner@localhost:5443/saas?schema=public

# --- Redis ---

# Monthly quota counters, ingest rate windows, the throttler, and the channel
# that tells ingest a plan changed. Compose runs it with append-only persistence.
REDIS_URL=redis://localhost:6389

# --- API service ---

API_PORT=4000

# PORT wins over API_PORT, matching what every container runtime injects. Empty
# locally: the web app reads PORT too.
PORT=

# Where the web app's server code reaches the API. The browser never calls it.
API_BASE_URL=http://localhost:4000

# Requests per minute. Signed-in calls are counted per user, sign-in per address.
# The two special budgets must stay below the global one or the API refuses to start.
RATE_LIMIT_GLOBAL=240
RATE_LIMIT_AUTH=5
RATE_LIMIT_INVITE=20

# --- Ingest service ---

INGEST_PORT=4200

# Shown to users in the "send your first event" snippet.
INGEST_PUBLIC_URL=http://localhost:4200

# Where the API reaches ingest for GET /status.
INGEST_INTERNAL_URL=http://localhost:4200

# Group commit: a workspace's events are written at once when nothing is
# writing for it, else together in the next transaction, at most this many per
# transaction. Every request is answered after its write commits.
INGEST_FLUSH_ROWS=1000

# --- Aggregator service ---

# How often the rollups catch up. Dashboards trail ingest by this plus a 5 s
# safety lag.
AGGREGATOR_INTERVAL_MS=2000
AGGREGATOR_HEALTH_PORT=4300
AGGREGATOR_INTERNAL_URL=http://localhost:4300

# --- Billing ---

# `mock`: checkout and the portal are pages of this app, and their webhooks are
# signed in Stripe's format, so the whole path runs with no account. `stripe`:
# Stripe TEST mode (a live key is refused) with prices whose lookup keys are
# team_monthly and business_monthly.
BILLING_DRIVER=mock
BILLING_MOCK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Web app ---

WEB_PORT=3000
APP_BASE_URL=http://localhost:3000

# --- Auth ---

# One value, two processes: the web app mints a short-lived HS256 service token
# and the API verifies it. At least 16 characters.
AUTH_SECRET=

# Auth.js reads this directly to build callback URLs.
AUTH_URL=http://localhost:3000
