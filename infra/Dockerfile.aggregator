# syntax=docker/dockerfile:1.7
#
# services/aggregator, multi-stage. Build from the REPO ROOT:
#   docker build -f infra/Dockerfile.aggregator -t saas-aggregator .

FROM node:20-bookworm-slim AS base
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /repo

FROM base AS fetch
COPY pnpm-lock.yaml pnpm-workspace.yaml ./
# --ignore-scripts: simple-git-hooks' postinstall walks up for a package.json this
# stage has deliberately not copied, and crashes the fetch.
RUN pnpm fetch --ignore-scripts

FROM fetch AS build
COPY . .
RUN pnpm install --frozen-lockfile --offline --ignore-scripts
RUN pnpm exec turbo run build --filter=@saas/aggregator...

FROM build AS prod-deps
RUN pnpm --filter @saas/aggregator deploy --prod /prod/aggregator
RUN test -f /prod/aggregator/dist/main.js || \
  (echo "prod-deps: /prod/aggregator/dist/main.js is missing after pnpm deploy." >&2 && exit 1)

FROM node:20-bookworm-slim AS runtime
RUN groupadd --gid 1001 app \
  && useradd --uid 1001 --gid app --shell /usr/sbin/nologin --no-create-home app
WORKDIR /app
COPY --from=prod-deps --chown=app:app /prod/aggregator ./
USER app
ENV NODE_ENV=production
EXPOSE 4300
# /health checks the dependencies for real, so a green container has a live
# Postgres and a recent aggregation pass behind it.
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "require('http').get('http://127.0.0.1:'+(process.env.AGGREGATOR_HEALTH_PORT||4300)+'/health',(r)=>process.exit(r.statusCode<500?0:1)).on('error',()=>process.exit(1))"
CMD ["node", "dist/main.js"]
